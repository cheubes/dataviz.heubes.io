---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { COVER_PLACEHOLDER, getCover } from '../scripts/covers';
import { getVisualizationSlug } from '../content.config';

interface Props {
  viz: CollectionEntry<'visualizations'>;
}

const { viz } = Astro.props;
const { lang, title, summary, themes } = viz.data;

const slug = getVisualizationSlug(viz.id, lang);
const href = lang === 'fr' ? `/fr/${slug}/` : `/${slug}/`;

const cover = getCover(slug);

// Rendered tile width in the catalog grid (minmax(340px, 1fr), --dv-space-4 gap,
// --dv-gutter padding, 1320px container): one column up to 727px of viewport,
// two up to 1091px, then three tiles of about 416px.
const COVER_SIZES = '(max-width: 727px) calc(100vw - 24px), (max-width: 1091px) calc(50vw - 24px), 416px';
---

<article class="dv-viz-card" data-themes={themes.join(' ')}>
  <a href={href} class="dv-viz-card__cover-link">
    {
      cover ? (
        <Image
          src={cover}
          alt={title}
          widths={[400, 800, 1200]}
          sizes={COVER_SIZES}
          format="webp"
          loading="lazy"
          class="dv-viz-card__cover"
        />
      ) : (
        <img src={COVER_PLACEHOLDER} alt={title} loading="lazy" width="1200" height="675" class="dv-viz-card__cover" />
      )
    }
  </a>
  <div class="dv-viz-card__body">
    <h3 class="dv-viz-card__title">
      <a href={href} class="dv-viz-card__title-link">{title}</a>
    </h3>
    <div class="dv-viz-card__scroll">
      <p class="dv-viz-card__summary">{summary}</p>
    </div>
  </div>
</article>

<style>
  .dv-viz-card {
    display: flex;
    flex-direction: column;
    background-color: var(--dv-surface);
    border: 1px solid var(--dv-gridline);
    border-radius: 4px;
    overflow: hidden;
    transition: box-shadow 0.15s ease, border-color 0.15s ease;
  }

  .dv-viz-card[hidden] {
    display: none;
  }

  .dv-viz-card:hover {
    box-shadow: 0 4px 12px rgba(11, 11, 11, 0.08);
    border-color: var(--dv-header-bg);
  }

  .dv-viz-card__cover-link {
    display: block;
  }

  .dv-viz-card__cover {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .dv-viz-card__body {
    display: flex;
    flex-direction: column;
    height: calc(9rem + 10px);
    padding: var(--dv-space-3);
  }

  .dv-viz-card__title {
    flex: 0 0 auto;
  }

  .dv-viz-card__title-link {
    color: inherit;
  }

  .dv-viz-card__scroll {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    margin-top: var(--dv-space-2);
    padding-right: var(--dv-space-2);
  }

  .dv-viz-card__summary {
    margin: 0;
    color: var(--dv-ink-secondary);
    text-align: justify;
  }
</style>
