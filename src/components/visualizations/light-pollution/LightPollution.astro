---
interface Props {
  lang: 'fr' | 'en';
}

const { lang } = Astro.props;
---

<div id="dv-light-pollution-root" data-lang={lang}></div>

<script>
  import { mountLightPollution } from './render';
  import en from '../../../i18n/en';
  import fr from '../../../i18n/fr';

  const root = document.getElementById('dv-light-pollution-root');
  if (root) {
    const lang = root.dataset.lang === 'fr' ? 'fr' : 'en';
    const labels = (lang === 'fr' ? fr : en).lightPollution;

    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          observer.disconnect();
          mountLightPollution(root, lang, labels);
        }
      },
      { rootMargin: '200px' }
    );
    observer.observe(root);
  }
</script>

<style is:global>
  .dv-light-pollution {
    display: flex;
    flex-direction: column;
    gap: var(--dv-space-3);
    padding: var(--dv-space-3);
  }

  .dv-light-pollution__status {
    margin: 0;
    text-align: center;
    color: var(--dv-ink-secondary);
    padding: var(--dv-space-5) 0;
  }

  .dv-light-pollution__stage {
    position: relative;
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
  }

  .dv-light-pollution__stage .dv-light-pollution__status {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
  }

  .dv-light-pollution__stage .dv-light-pollution__status[hidden] {
    display: none;
  }

  .dv-light-pollution__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .dv-light-pollution__basemap {
    fill: #e4e2da;
    stroke: none;
  }

  .dv-light-pollution__hex {
    cursor: pointer;
    stroke: var(--dv-gridline);
    stroke-width: 0.5;
  }

  .dv-light-pollution__tooltip {
    position: absolute;
    z-index: 2;
    max-width: 240px;
    padding: var(--dv-space-2);
    background-color: var(--dv-header-bg);
    color: #ffffff;
    border-radius: 4px;
    font-size: 0.8125rem;
    line-height: 1.4;
    pointer-events: none;
  }

  .dv-light-pollution__controls {
    display: flex;
    flex-direction: column;
    gap: var(--dv-space-2);
    align-items: center;
    text-align: center;
  }

  .dv-light-pollution__legend {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--dv-space-1) var(--dv-space-3);
    font-size: 0.75rem;
    color: var(--dv-ink-secondary);
  }

  .dv-light-pollution__legend-item {
    display: inline-flex;
    align-items: center;
    gap: var(--dv-space-1);
    white-space: nowrap;
  }

  .dv-light-pollution__legend-swatch {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 2px;
    border: 1px solid var(--dv-gridline);
  }

  .dv-light-pollution__playback {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--dv-space-2);
    width: 100%;
    max-width: 520px;
  }

  .dv-light-pollution__play {
    font-family: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    color: #ffffff;
    background-color: var(--dv-accent);
    border: none;
    border-radius: 4px;
    padding: var(--dv-space-1) var(--dv-space-3);
    cursor: pointer;
    min-height: 36px;
  }

  .dv-light-pollution__speed {
    font-family: inherit;
    font-size: 0.875rem;
    padding: var(--dv-space-1) var(--dv-space-2);
    border: 1px solid var(--dv-gridline);
    border-radius: 4px;
    background-color: var(--dv-surface);
    color: var(--dv-ink-primary);
    min-height: 36px;
  }

  .dv-light-pollution__year-group {
    display: flex;
    align-items: center;
    gap: var(--dv-space-2);
    flex: 1 1 220px;
  }

  .dv-light-pollution__year-group label {
    font-size: 0.875rem;
    color: var(--dv-ink-secondary);
  }

  .dv-light-pollution__year-slider {
    flex: 1;
    min-height: 28px;
  }

  .dv-light-pollution__year-value {
    font-weight: 500;
    color: var(--dv-ink-primary);
    min-width: 3ch;
  }
</style>
