---
interface Props {
  lang: 'fr' | 'en';
}

const { lang } = Astro.props;
---

<div id="dv-paris-trees-root" data-lang={lang}></div>

<script>
  import { mountParisTrees } from './render';
  import en from '../../../i18n/en';
  import fr from '../../../i18n/fr';

  const root = document.getElementById('dv-paris-trees-root');
  if (root) {
    const lang = root.dataset.lang === 'fr' ? 'fr' : 'en';
    const labels = (lang === 'fr' ? fr : en).parisTrees;

    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          observer.disconnect();
          mountParisTrees(root, lang, labels);
        }
      },
      { rootMargin: '200px' }
    );
    observer.observe(root);
  }
</script>

<style is:global>
  .dv-paris-trees {
    display: flex;
    flex-direction: column;
    gap: var(--dv-space-3);
    padding: var(--dv-space-3);
  }

  .dv-paris-trees__status {
    margin: 0;
    text-align: center;
    color: var(--dv-ink-secondary);
    padding: var(--dv-space-5) 0;
  }

  .dv-paris-trees__controls {
    display: flex;
    flex-direction: column;
    gap: var(--dv-space-2);
  }

  .dv-paris-trees__controls-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--dv-space-4);
    align-items: center;
  }

  .dv-paris-trees__search {
    display: flex;
    align-items: center;
    gap: var(--dv-space-2);
    font-size: 0.875rem;
    color: var(--dv-ink-secondary);
  }

  .dv-paris-trees__search-input {
    font-family: inherit;
    font-size: 0.875rem;
    padding: var(--dv-space-1) var(--dv-space-2);
    border: 1px solid var(--dv-gridline);
    border-radius: 4px;
    background-color: var(--dv-surface);
    color: var(--dv-ink-primary);
    min-height: 36px;
    min-width: 220px;
  }

  .dv-paris-trees__control-group {
    display: flex;
    flex-wrap: wrap;
    gap: var(--dv-space-3);
    align-items: center;
  }

  .dv-paris-trees__toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--dv-space-1);
    font-size: 0.875rem;
    color: var(--dv-ink-secondary);
    cursor: pointer;
  }

  .dv-paris-trees__swatch {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .dv-paris-trees__swatch--ring {
    background-color: transparent;
    border: 1.5px solid;
  }

  .dv-paris-trees__footnote {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--dv-ink-secondary);
  }

  .dv-paris-trees__count {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--dv-ink-primary);
    margin-left: auto;
  }

  .dv-paris-trees__stage {
    position: relative;
    width: 100%;
    touch-action: none;
  }

  .dv-paris-trees__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .dv-paris-trees__zoom-controls {
    position: absolute;
    z-index: 2;
    right: var(--dv-space-3);
    top: var(--dv-space-3);
    display: flex;
    flex-direction: column;
    gap: 1px;
    border-radius: 4px;
    overflow: hidden;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.25);
  }

  .dv-paris-trees__zoom-button {
    font-family: inherit;
    font-size: 1.125rem;
    line-height: 1;
    color: var(--dv-ink-primary);
    background-color: var(--dv-surface);
    border: none;
    width: 36px;
    height: 36px;
    cursor: pointer;
  }

  .dv-paris-trees__zoom-button:hover:not(:disabled) {
    background-color: var(--dv-gridline);
  }

  .dv-paris-trees__zoom-button:disabled {
    color: var(--dv-gridline);
    cursor: default;
  }

  .dv-paris-trees__zoom-button--reset {
    font-size: 0.9375rem;
  }

  .dv-paris-trees__tooltip {
    position: absolute;
    z-index: 2;
    max-width: 240px;
    padding: var(--dv-space-2);
    background-color: var(--dv-header-bg);
    color: #ffffff;
    border-radius: 4px;
    font-size: 0.8125rem;
    line-height: 1.4;
    pointer-events: none;
  }

  .dv-paris-trees__tooltip-remarkable {
    display: inline-block;
    margin-top: var(--dv-space-1);
    color: var(--dv-gold);
    font-weight: 500;
  }

  .dv-paris-trees__stage .dv-paris-trees__status {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    /* Message only, no controls inside it: without this, it silently
       swallows every pointer event over the whole stage while shown (no
       genus selected, or a search with no match), including the drag/wheel
       gesture d3-zoom listens for on the canvas underneath. */
    pointer-events: none;
  }

  .dv-paris-trees__stage .dv-paris-trees__status[hidden] {
    display: none;
  }

  @media (max-width: 640px) {
    .dv-paris-trees__controls-row {
      flex-direction: column;
      align-items: flex-start;
    }

    .dv-paris-trees__count {
      margin-left: 0;
    }
  }
</style>
