---
interface Props {
  lang: 'fr' | 'en';
}

const { lang } = Astro.props;
---

<div id="dv-flower-phenology-root" data-lang={lang}></div>

<script>
  import { mountFlowerPhenology } from './render';
  import en from '../../../i18n/en';
  import fr from '../../../i18n/fr';

  const root = document.getElementById('dv-flower-phenology-root');
  if (root) {
    const lang = root.dataset.lang === 'fr' ? 'fr' : 'en';
    const labels = (lang === 'fr' ? fr : en).flowerPhenology;

    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          observer.disconnect();
          mountFlowerPhenology(root, lang, labels);
        }
      },
      { rootMargin: '200px' }
    );
    observer.observe(root);
  }
</script>

<style is:global>
  .dv-flower-phenology {
    display: flex;
    flex-direction: column;
    gap: var(--dv-space-3);
    padding: var(--dv-space-3);
  }

  .dv-flower-phenology__status {
    margin: 0;
    text-align: center;
    color: var(--dv-ink-secondary);
    padding: var(--dv-space-5) 0;
  }

  .dv-flower-phenology__controls {
    display: flex;
    flex-direction: column;
    gap: var(--dv-space-2);
  }

  .dv-flower-phenology__species-group {
    display: flex;
    flex-wrap: wrap;
    gap: var(--dv-space-1) var(--dv-space-3);
  }

  .dv-flower-phenology__toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--dv-space-1);
    font-size: 0.875rem;
    color: var(--dv-ink-secondary);
    cursor: pointer;
    white-space: nowrap;
  }

  .dv-flower-phenology__swatch {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 1px solid var(--dv-gridline);
  }

  .dv-flower-phenology__decade-group {
    display: flex;
    flex-wrap: wrap;
    gap: var(--dv-space-4);
    align-items: center;
  }

  .dv-flower-phenology__decade-field {
    display: inline-flex;
    align-items: center;
    gap: var(--dv-space-2);
  }

  .dv-flower-phenology__decade-label {
    font-size: 0.875rem;
    font-weight: 300;
    color: var(--dv-ink-secondary);
  }

  .dv-flower-phenology__decade-select {
    font-family: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    padding: var(--dv-space-1) var(--dv-space-2);
    border: 1px solid var(--dv-gridline);
    border-radius: 4px;
    background-color: var(--dv-surface);
    color: var(--dv-ink-primary);
    min-height: 36px;
  }

  .dv-flower-phenology__stage {
    position: relative;
    width: 100%;
    max-width: 640px;
    margin: 0 auto;
    aspect-ratio: 1 / 1;
    touch-action: none;
  }

  .dv-flower-phenology__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .dv-flower-phenology__arc {
    cursor: pointer;
  }

  .dv-flower-phenology__tooltip {
    position: absolute;
    z-index: 2;
    max-width: 220px;
    padding: var(--dv-space-2);
    background-color: var(--dv-header-bg);
    color: #ffffff;
    border-radius: 4px;
    font-size: 0.8125rem;
    line-height: 1.4;
    pointer-events: none;
  }

  .dv-flower-phenology__stage .dv-flower-phenology__status {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
  }

  .dv-flower-phenology__stage .dv-flower-phenology__status[hidden] {
    display: none;
  }

  @media (max-width: 640px) {
    .dv-flower-phenology__species-group {
      flex-wrap: nowrap;
      overflow-x: auto;
      padding-bottom: var(--dv-space-1);
    }
  }
</style>
