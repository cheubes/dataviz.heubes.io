---
interface Props {
  lang: 'fr' | 'en';
}

const { lang } = Astro.props;
---

<div id="dv-animal-migrations-root" data-lang={lang}></div>

<script>
  import { mountAnimalMigrations } from './render';
  import en from '../../../i18n/en';
  import fr from '../../../i18n/fr';

  const root = document.getElementById('dv-animal-migrations-root');
  if (root) {
    const lang = root.dataset.lang === 'fr' ? 'fr' : 'en';
    const labels = (lang === 'fr' ? fr : en).animalMigrations;

    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          observer.disconnect();
          mountAnimalMigrations(root, lang, labels);
        }
      },
      { rootMargin: '200px' }
    );
    observer.observe(root);
  }
</script>

<style is:global>
  .dv-animal-migrations {
    display: flex;
    flex-direction: column;
    gap: var(--dv-space-3);
    padding: var(--dv-space-3);
  }

  .dv-animal-migrations__status {
    margin: 0;
    text-align: center;
    color: var(--dv-ink-secondary);
    padding: var(--dv-space-5) 0;
  }

  .dv-animal-migrations__controls-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--dv-space-4);
    align-items: center;
  }

  .dv-animal-migrations__separator {
    color: var(--dv-gridline);
  }

  .dv-animal-migrations__control-group {
    display: flex;
    flex-wrap: wrap;
    gap: var(--dv-space-3);
    align-items: center;
  }

  .dv-animal-migrations__toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--dv-space-1);
    font-size: 0.875rem;
    color: var(--dv-ink-secondary);
    cursor: pointer;
  }

  .dv-animal-migrations__swatch {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .dv-animal-migrations__play {
    font-family: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    color: #ffffff;
    background-color: var(--dv-accent);
    border: none;
    border-radius: 4px;
    padding: var(--dv-space-1) var(--dv-space-3);
    cursor: pointer;
    min-height: 36px;
  }

  .dv-animal-migrations__speed {
    font-family: inherit;
    font-size: 0.875rem;
    padding: var(--dv-space-1) var(--dv-space-2);
    border: 1px solid var(--dv-gridline);
    border-radius: 4px;
    background-color: var(--dv-surface);
    color: var(--dv-ink-primary);
    min-height: 36px;
  }

  .dv-animal-migrations__date {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--dv-ink-primary);
    min-width: 6ch;
  }

  .dv-animal-migrations__stage {
    position: relative;
    width: 100%;
    touch-action: none;
  }

  .dv-animal-migrations__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .dv-animal-migrations__tooltip {
    position: absolute;
    z-index: 2;
    max-width: 220px;
    padding: var(--dv-space-2);
    background-color: var(--dv-header-bg);
    color: #ffffff;
    border-radius: 4px;
    font-size: 0.8125rem;
    line-height: 1.4;
    pointer-events: none;
  }

  .dv-animal-migrations__stage .dv-animal-migrations__status {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
  }

  .dv-animal-migrations__stage .dv-animal-migrations__status[hidden] {
    display: none;
  }

  @media (max-width: 640px) {
    .dv-animal-migrations__controls-row {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
