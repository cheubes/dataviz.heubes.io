---
interface Props {
  lang: 'fr' | 'en';
}

const { lang } = Astro.props;
---

<div id="dv-volcanic-eruptions-root" data-lang={lang}></div>

<script>
  import { mountVolcanicEruptions } from './render';
  import en from '../../../i18n/en';
  import fr from '../../../i18n/fr';

  const root = document.getElementById('dv-volcanic-eruptions-root');
  if (root) {
    const lang = root.dataset.lang === 'fr' ? 'fr' : 'en';
    const labels = (lang === 'fr' ? fr : en).volcanicEruptions;

    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          observer.disconnect();
          mountVolcanicEruptions(root, lang, labels);
        }
      },
      { rootMargin: '200px' }
    );
    observer.observe(root);
  }
</script>

<style is:global>
  .dv-volcanic-eruptions {
    display: flex;
    flex-direction: column;
    gap: var(--dv-space-3);
    padding: var(--dv-space-3);
  }

  .dv-volcanic-eruptions__status {
    margin: 0;
    text-align: center;
    color: var(--dv-ink-secondary);
    padding: var(--dv-space-5) 0;
  }

  .dv-volcanic-eruptions__controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--dv-space-3);
  }

  .dv-volcanic-eruptions__play {
    font-family: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    color: #ffffff;
    background-color: var(--dv-accent);
    border: none;
    border-radius: 4px;
    padding: var(--dv-space-1) var(--dv-space-3);
    cursor: pointer;
    min-height: 36px;
  }

  .dv-volcanic-eruptions__speed {
    font-family: inherit;
    font-size: 0.875rem;
    padding: var(--dv-space-1) var(--dv-space-2);
    border: 1px solid var(--dv-gridline);
    border-radius: 4px;
    background-color: var(--dv-surface);
    color: var(--dv-ink-primary);
    min-height: 36px;
  }

  .dv-volcanic-eruptions__year-group {
    display: flex;
    align-items: center;
    gap: var(--dv-space-2);
    flex: 1 1 220px;
  }

  .dv-volcanic-eruptions__year-group label {
    font-size: 0.875rem;
    color: var(--dv-ink-secondary);
  }

  .dv-volcanic-eruptions__year-slider {
    flex: 1;
    min-height: 28px;
  }

  .dv-volcanic-eruptions__year {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--dv-ink-primary);
    min-width: 9ch;
  }

  .dv-volcanic-eruptions__stage {
    position: relative;
    width: 100%;
    touch-action: none;
  }

  .dv-volcanic-eruptions__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .dv-volcanic-eruptions__zoom-controls {
    position: absolute;
    z-index: 2;
    right: var(--dv-space-3);
    top: var(--dv-space-3);
    display: flex;
    flex-direction: column;
    gap: 1px;
    border-radius: 4px;
    overflow: hidden;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.25);
  }

  .dv-volcanic-eruptions__zoom-button {
    font-family: inherit;
    font-size: 1.125rem;
    line-height: 1;
    color: var(--dv-ink-primary);
    background-color: var(--dv-surface);
    border: none;
    width: 36px;
    height: 36px;
    cursor: pointer;
  }

  .dv-volcanic-eruptions__zoom-button:hover:not(:disabled) {
    background-color: var(--dv-gridline);
  }

  .dv-volcanic-eruptions__zoom-button:disabled {
    color: var(--dv-gridline);
    cursor: default;
  }

  .dv-volcanic-eruptions__zoom-button--reset {
    font-size: 0.9375rem;
  }

  .dv-volcanic-eruptions__annotation {
    position: absolute;
    z-index: 2;
    max-width: 200px;
    padding: var(--dv-space-1) var(--dv-space-2);
    background-color: var(--dv-header-bg);
    color: #ffffff;
    border-radius: 4px;
    font-size: 0.8125rem;
    line-height: 1.4;
    font-weight: 500;
    pointer-events: none;
    transform: translate(-50%, -100%);
    margin-top: -10px;
  }

  .dv-volcanic-eruptions__tooltip {
    position: absolute;
    z-index: 2;
    max-width: 220px;
    padding: var(--dv-space-2);
    background-color: var(--dv-header-bg);
    color: #ffffff;
    border-radius: 4px;
    font-size: 0.8125rem;
    line-height: 1.4;
    pointer-events: none;
  }

  .dv-volcanic-eruptions__stage .dv-volcanic-eruptions__status {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
  }

  .dv-volcanic-eruptions__stage .dv-volcanic-eruptions__status[hidden] {
    display: none;
  }

  @media (max-width: 640px) {
    .dv-volcanic-eruptions__controls {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
