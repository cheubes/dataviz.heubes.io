---
import en from '../i18n/en';
import fr from '../i18n/fr';

interface Props {
  lang?: 'fr' | 'en';
}

const { lang = 'en' } = Astro.props;

const licenseUrl = lang === 'fr'
  ? 'https://creativecommons.org/publicdomain/zero/1.0/deed.fr'
  : 'https://creativecommons.org/publicdomain/zero/1.0/deed.en';

const creditLabel = lang === 'fr' ? 'Réalisée par' : 'Created by';
const aboutLabel = (lang === 'fr' ? fr : en).about.title;
const aboutHref = lang === 'fr' ? '/fr/about/' : '/about/';

// Creative Commons icons from Font Awesome Free 7.3.1 (https://fontawesome.com,
// icons under CC BY 4.0), inlined as SVG paths rather than loading the whole
// Font Awesome stylesheet and font for two icons.
const ccIconPaths = [
  'M253.8 214.9l-33.2 17.3c-9.4-19.6-25.2-19.9-27.5-19.9-22.1 0-33.2 14.6-33.2 43.8 0 23.6 9.2 43.8 33.2 43.8 14.5 0 24.6-7.1 30.6-21.3l30.6 15.5c-6.2 11.5-25.7 39-65.1 39-22.6 0-74-10.3-74-77 0-58.7 43-77.1 72.6-77.1 30.7 0 52.7 11.9 66 35.9zm143 0l-32.8 17.3c-9.5-19.8-25.7-19.9-27.9-19.9-22.1 0-33.2 14.6-33.2 43.8 0 23.5 9.2 43.8 33.2 43.8 14.4 0 24.6-7.1 30.5-21.3l31 15.5c-2.1 3.8-21.4 39-65.1 39-22.7 0-74-9.9-74-77 0-58.7 43-77.1 72.6-77.1 30.7 0 52.6 11.9 65.6 35.9zM255.6 8C112.7 8 8 123.1 8 256.1 8 394.5 121.6 504.1 255.6 504.1 385.5 504.1 504 403.2 504 256.1 504 118.2 397.4 8 255.6 8zm.9 450.8c-112.5 0-203.7-93-203.7-202.8 0-105.4 85.4-203.3 203.7-203.3 112.5 0 202.8 89.5 202.8 203.3 0 121.7-99.7 202.8-202.8 202.8z',
  'M255.6 8C397.4 8 504 118.1 504 256 504 403.1 385.5 504 255.6 504 121.6 504 8 394.5 8 256 8 123.1 112.7 8 255.6 8zm.8 44.7c-118.2 0-203.7 97.9-203.7 203.3 0 109.8 91.2 202.8 203.7 202.8 103.2 0 202.8-81.1 202.8-202.8 .1-113.8-90.2-203.3-202.8-203.3zm-.4 60.5c-81.9 0-102.5 77.3-102.5 142.8S174.1 398.8 256 398.8 358.5 321.5 358.5 256 337.9 113.2 256 113.2zm0 53.9c3.3 0 6.4 .5 9.2 1.2 5.9 5.1 8.8 12.1 3.1 21.9L213.8 290.4c-1.7-12.7-1.9-25.1-1.9-34.4 0-28.8 2-88.9 44.1-88.9zm40.8 46.2c2.9 15.4 3.3 31.4 3.3 42.7 0 28.9-2 88.9-44.1 88.9-13.5 0-32.6-7.7-20.1-26.4l60.9-105.2z',
];
---

<footer class="dv-footer">
  <div class="dv-footer__inner">
    <p class="dv-footer__license">
      <a href={licenseUrl} target="_blank" rel="license noopener" class="dv-footer__cc-link">
        <span class="dv-footer__cc-icons">
          {
            ccIconPaths.map((path) => (
              <svg viewBox="0 0 512 512" aria-hidden="true" class="dv-footer__cc-icon">
                <path d={path} />
              </svg>
            ))
          }
        </span>
        <span>CC0 1.0</span>
      </a>
    </p>
    <p class="dv-footer__credit">
      <a href={aboutHref}>{aboutLabel}</a> · {creditLabel} <a href="https://christophe.heubes.org">Christophe Heubès</a>
    </p>
  </div>
</footer>

<style>
  .dv-footer {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    z-index: 10;
    background-color: var(--dv-footer-bg);
    color: #ffffff;
    border-top: 2px solid var(--dv-gridline);
    font-size: 0.8rem;
  }

  .dv-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--dv-space-2);
    padding: var(--dv-space-2) var(--dv-gutter);
  }

  .dv-footer__license,
  .dv-footer__credit {
    margin: 0;
  }

  .dv-footer a {
    color: inherit;
  }

  .dv-footer a:hover {
    color: var(--dv-gold);
  }

  .dv-footer__cc-link {
    display: inline-flex;
    align-items: center;
    gap: var(--dv-space-2);
  }

  .dv-footer__cc-icons {
    display: inline-flex;
  }

  /* Same box as the Font Awesome glyphs these replace: text-sized, in a 1.25em
     wide cell that spaces the icons apart. */
  .dv-footer__cc-icon {
    width: 1.25em;
    height: 1em;
    fill: currentColor;
  }
</style>
