---
import LanguageSelector from './LanguageSelector.astro';
import { getLangFromPathname } from '../scripts/language';

const homeHref = getLangFromPathname(Astro.url.pathname) === 'fr' ? '/fr/' : '/';
---

<header class="dv-header">
  <div class="dv-header__inner">
    <a href={homeHref} class="dv-header__brand">
      <img src="/logo.png" alt="" class="dv-header__logo" />
      <span class="dv-header__site-name">dataviz.heubes.io</span>
    </a>
    <LanguageSelector />
  </div>
</header>

<style>
  .dv-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background-color: var(--dv-header-bg);
    color: #ffffff;
    border-bottom: 2px solid var(--dv-gold);
  }

  .dv-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--dv-space-3);
    padding-inline: var(--dv-gutter);
  }

  .dv-header__brand {
    display: flex;
    align-items: center;
    gap: var(--dv-space-2);
    color: #ffffff;
  }

  .dv-header__brand:hover {
    color: var(--dv-gold);
  }

  .dv-header__logo {
    height: 48px;
    width: auto;
  }

  .dv-header__site-name {
    font-weight: 700;
    font-size: 1.25rem;
  }
</style>
