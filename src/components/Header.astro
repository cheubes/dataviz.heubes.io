---
import LanguageSelector from './LanguageSelector.astro';
import { getLangFromPathname } from '../scripts/language';
import en from '../i18n/en';
import fr from '../i18n/fr';

const lang = getLangFromPathname(Astro.url.pathname);
const t = lang === 'fr' ? fr : en;
const homeHref = lang === 'fr' ? '/fr/' : '/';
---

<header class="dv-header">
  <div class="dv-header__inner">
    <a href={homeHref} class="dv-header__brand">
      <img src="/logo.png" alt="" class="dv-header__logo" />
      <span class="dv-header__brand-text">
        <span class="dv-header__site-name">{t.site.name}</span>
        <span class="dv-header__tagline">{t.site.tagline}</span>
      </span>
    </a>
    <LanguageSelector />
  </div>
</header>

<style>
  .dv-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background-color: var(--dv-header-bg);
    color: #ffffff;
    border-bottom: 2px solid var(--dv-gold);
  }

  .dv-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--dv-space-3);
    padding-inline: var(--dv-gutter);
  }

  .dv-header__brand {
    display: flex;
    align-items: center;
    gap: var(--dv-space-2);
    color: #ffffff;
  }

  .dv-header__brand:hover {
    color: var(--dv-gold);
  }

  .dv-header__logo {
    height: 48px;
    width: auto;
  }

  .dv-header__brand-text {
    display: flex;
    flex-direction: column;
  }

  .dv-header__site-name {
    font-weight: 700;
    font-size: 1.25rem;
  }

  .dv-header__tagline {
    font-size: 0.75rem;
    font-weight: 300;
    opacity: 0.85;
  }
</style>
