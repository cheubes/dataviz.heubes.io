---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Content } from '../../content/about/about.fr.md';
import fr from '../../i18n/fr';

const LANG = 'fr';
---

<BaseLayout
  title={`${fr.about.title} · ${fr.site.name}`}
  description={fr.about.description}
  lang={LANG}
  alternatePath="/about/"
>
  <article class="dv-about-page">
    <h1>{fr.about.title}</h1>
    <Content />
  </article>
</BaseLayout>

<style>
  /* :global() is required here: <Content /> renders the markdown without this
     component's Astro scope attribute (same constraint as [viz].astro). */
  .dv-about-page > :global(:last-child) {
    margin-bottom: 0;
  }

  .dv-about-page :global(a) {
    color: var(--dv-accent);
  }
</style>
