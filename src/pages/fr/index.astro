---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import VizCard from '../../components/VizCard.astro';
import ThemeFilter from '../../components/ThemeFilter.astro';
import fr from '../../i18n/fr';

const LANG = 'fr';

// Alphabetical by slug (home-page.md), made explicit rather than left to the
// collection's own order, which changed between Astro 5 and 7.
const visualizations = (await getCollection('visualizations', (viz) => viz.data.lang === LANG)).sort((a, b) =>
  a.id.localeCompare(b.id)
);
---

<BaseLayout
  title={fr.site.name}
  description={fr.home.description}
  lang={LANG}
  alternatePath="/"
>
  {
    visualizations.length === 0 ? (
      <p>{fr.home.empty}</p>
    ) : (
      <>
        <ThemeFilter labels={fr.themes} ariaLabel={fr.home.themeFilterLabel} />
        <p class="dv-catalog-empty" data-theme-filter-empty hidden>
          {fr.home.noResults}
        </p>
        <div class="dv-catalog-grid">
          {visualizations.map((viz) => (
            <VizCard viz={viz} />
          ))}
        </div>
      </>
    )
  }
</BaseLayout>

<style>
  .dv-catalog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: var(--dv-space-4);
  }

  .dv-catalog-empty {
    color: var(--dv-ink-secondary);
  }
</style>
