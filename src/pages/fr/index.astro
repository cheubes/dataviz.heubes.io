---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import VizCard from '../../components/VizCard.astro';
import fr from '../../i18n/fr';

const LANG = 'fr';

const visualizations = await getCollection('visualizations', (viz) => viz.data.lang === LANG);
---

<BaseLayout
  title="dataviz.heubes.io"
  description={fr.home.description}
  lang={LANG}
  alternatePath="/"
>
  {
    visualizations.length === 0 ? (
      <p>{fr.home.empty}</p>
    ) : (
      <div class="dv-catalog-grid">
        {visualizations.map((viz) => (
          <VizCard viz={viz} />
        ))}
      </div>
    )
  }
</BaseLayout>

<style>
  .dv-catalog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: var(--dv-space-4);
  }
</style>
