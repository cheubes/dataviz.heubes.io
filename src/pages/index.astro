---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import VizCard from '../components/VizCard.astro';
import ThemeFilter from '../components/ThemeFilter.astro';
import en from '../i18n/en';

const LANG = 'en';

const visualizations = await getCollection('visualizations', (viz) => viz.data.lang === LANG);
---

<BaseLayout
  title={en.site.name}
  description={en.home.description}
  lang={LANG}
  alternatePath="/fr/"
>
  {
    visualizations.length === 0 ? (
      <p>{en.home.empty}</p>
    ) : (
      <>
        <ThemeFilter labels={en.themes} ariaLabel={en.home.themeFilterLabel} />
        <p class="dv-catalog-empty" data-theme-filter-empty hidden>
          {en.home.noResults}
        </p>
        <div class="dv-catalog-grid">
          {visualizations.map((viz) => (
            <VizCard viz={viz} />
          ))}
        </div>
      </>
    )
  }
</BaseLayout>

<style>
  .dv-catalog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: var(--dv-space-4);
  }

  .dv-catalog-empty {
    color: var(--dv-ink-secondary);
  }
</style>
