---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import VizCard from '../components/VizCard.astro';
import en from '../i18n/en';

const LANG = 'en';

const visualizations = await getCollection('visualizations', (viz) => viz.data.lang === LANG);
---

<BaseLayout
  title="dataviz.heubes.io"
  description={en.home.description}
  lang={LANG}
  alternatePath="/fr/"
>
  {
    visualizations.length === 0 ? (
      <p>{en.home.empty}</p>
    ) : (
      <div class="dv-catalog-grid">
        {visualizations.map((viz) => (
          <VizCard viz={viz} />
        ))}
      </div>
    )
  }
</BaseLayout>

<style>
  .dv-catalog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: var(--dv-space-4);
  }
</style>
