---
import { getCollection, render } from 'astro:content';
import { existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getVisualizationSlug } from '../content/config';
import BirdMigrations from '../components/visualizations/bird-migrations/BirdMigrations.astro';
import en from '../i18n/en';

const LANG = 'en';

export async function getStaticPaths() {
  const [visualizations, frVisualizations] = await Promise.all([
    getCollection('visualizations', (viz) => viz.data.lang === 'en'),
    getCollection('visualizations', (viz) => viz.data.lang === 'fr'),
  ]);
  const frSlugs = new Set(
    frVisualizations.map((viz) => getVisualizationSlug(viz.id, viz.data.lang))
  );
  return visualizations.map((viz) => {
    const slug = getVisualizationSlug(viz.id, viz.data.lang);
    return {
      params: { viz: slug },
      props: { viz, hasTranslation: frSlugs.has(slug) },
    };
  });
}

const { viz, hasTranslation } = Astro.props;
const { lang, title, summary, datasets } = viz.data;
const slug = getVisualizationSlug(viz.id, lang);
const { Content } = await render(viz);

const coverExtension = ['jpg', 'png'].find((ext) =>
  existsSync(fileURLToPath(new URL(`../../public/covers/${slug}.${ext}`, import.meta.url)))
);
const coverPath = coverExtension ? `/covers/${slug}.${coverExtension}` : '/cover-placeholder.svg';
const alternatePath = hasTranslation ? `/fr/${slug}/` : undefined;
---

<BaseLayout
  title={`${title} · ${en.site.name}`}
  description={summary}
  lang={LANG}
  cover={coverPath}
  alternatePath={alternatePath}
>
  <article class="dv-viz-page">
    <h1>{title}</h1>
    <p class="dv-viz-page__summary">{summary}</p>

    <div class="dv-viz-page__body">
      <Content />
    </div>

    <div class="dv-viz-page__mount">
      {/* TODO: replace with a slug -> component lookup once a second visualization exists */}
      {slug === 'bird-migrations' && <BirdMigrations lang={LANG} />}
    </div>

    <section class="dv-viz-page__credits">
      <h2>{en.viz.sourcesHeading}</h2>
      <ul class="dv-viz-page__dataset-list">
        {
          datasets.map((dataset) => (
            <li class="dv-viz-page__dataset">
              <a href={dataset.url} target="_blank" rel="noopener" class="dv-viz-page__dataset-name">
                {dataset.name}
              </a>
              <span class="dv-viz-page__dataset-meta">
                {[
                  dataset.publisher,
                  dataset.license,
                  dataset.retrieved && `${en.viz.retrievedLabel} ${dataset.retrieved}`,
                ]
                  .filter(Boolean)
                  .join(' · ')}
              </span>
            </li>
          ))
        }
      </ul>
    </section>
  </article>
</BaseLayout>

<style>
  .dv-viz-page {
    display: flex;
    flex-direction: column;
    gap: var(--dv-space-4);
  }

  .dv-viz-page__summary {
    margin: 0;
    font-size: 1.125rem;
  }

  .dv-viz-page__credits h2 {
    margin-bottom: var(--dv-space-2);
  }

  .dv-viz-page__dataset-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--dv-space-1);
  }

  .dv-viz-page__dataset {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--dv-space-2);
    font-size: 0.875rem;
    font-weight: 300;
    color: var(--dv-ink-secondary);
  }

  .dv-viz-page__dataset-name {
    color: var(--dv-accent);
  }

  .dv-viz-page__mount {
    width: 100%;
    min-height: 480px;
    border: 1px solid var(--dv-gridline);
    border-radius: 4px;
    background-color: var(--dv-surface);
  }
</style>
