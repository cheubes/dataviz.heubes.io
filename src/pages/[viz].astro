---
import { getCollection, render } from 'astro:content';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import RelatedVisualizations from '../components/RelatedVisualizations.astro';
import DataDownloads from '../components/DataDownloads.astro';
import DataTable from '../components/DataTable.astro';
import type { DataTableBuilder } from '../scripts/data-table';
import { buildFlowerPhenologyTable } from '../components/visualizations/flower-phenology/table';
import { buildForestFiresTable } from '../components/visualizations/forest-fires/table';
import { buildMedicalDesertsTable } from '../components/visualizations/medical-deserts/table';
import { buildBiodiversityTable } from '../components/visualizations/biodiversity/table';
import { buildBirdMigrationsTable } from '../components/visualizations/bird-migrations/table';
import { buildEarthquakesTable } from '../components/visualizations/earthquakes/table';
import { buildEndangeredSpeciesTable } from '../components/visualizations/endangered-species/table';
import { buildGrapeHarvestAlmanacTable } from '../components/visualizations/grape-harvest-almanac/table';
import { buildLightPollutionTable } from '../components/visualizations/light-pollution/table';
import { buildMonarchMigrationTable } from '../components/visualizations/monarch-migration/table';
import { buildMonumentLayersTable } from '../components/visualizations/monument-layers/table';
import { buildParisTreesTable } from '../components/visualizations/paris-trees/table';
import { buildSatellitesInOrbitTable } from '../components/visualizations/satellites-in-orbit/table';
import { buildVolcanicEruptionsTable } from '../components/visualizations/volcanic-eruptions/table';
import { getVisualizationSlug } from '../content.config';
import { validateVisualizations } from '../content/validation';
import BirdMigrations from '../components/visualizations/bird-migrations/BirdMigrations.astro';
import FlowerPhenology from '../components/visualizations/flower-phenology/FlowerPhenology.astro';
import Biodiversity from '../components/visualizations/biodiversity/Biodiversity.astro';
import ParisTrees from '../components/visualizations/paris-trees/ParisTrees.astro';
import SatellitesInOrbit from '../components/visualizations/satellites-in-orbit/SatellitesInOrbit.astro';
import LightPollution from '../components/visualizations/light-pollution/LightPollution.astro';
import MonumentLayers from '../components/visualizations/monument-layers/MonumentLayers.astro';
import GrapeHarvestAlmanac from '../components/visualizations/grape-harvest-almanac/GrapeHarvestAlmanac.astro';
import EndangeredSpecies from '../components/visualizations/endangered-species/EndangeredSpecies.astro';
import Earthquakes from '../components/visualizations/earthquakes/Earthquakes.astro';
import MonarchMigration from '../components/visualizations/monarch-migration/MonarchMigration.astro';
import ForestFires from '../components/visualizations/forest-fires/ForestFires.astro';
import VolcanicEruptions from '../components/visualizations/volcanic-eruptions/VolcanicEruptions.astro';
import MedicalDeserts from '../components/visualizations/medical-deserts/MedicalDeserts.astro';
import en from '../i18n/en';

const VIZ_COMPONENTS: Record<string, typeof BirdMigrations> = {
  'bird-migrations': BirdMigrations,
  'flower-phenology': FlowerPhenology,
  biodiversity: Biodiversity,
  'paris-trees': ParisTrees,
  'satellites-in-orbit': SatellitesInOrbit,
  'light-pollution': LightPollution,
  'monument-layers': MonumentLayers,
  'grape-harvest-almanac': GrapeHarvestAlmanac,
  'endangered-species': EndangeredSpecies,
  earthquakes: Earthquakes,
  'monarch-migration': MonarchMigration,
  'forest-fires': ForestFires,
  'volcanic-eruptions': VolcanicEruptions,
  'medical-deserts': MedicalDeserts,
};

const VIZ_TABLES: Record<string, DataTableBuilder> = {
  biodiversity: buildBiodiversityTable,
  'bird-migrations': buildBirdMigrationsTable,
  earthquakes: buildEarthquakesTable,
  'endangered-species': buildEndangeredSpeciesTable,
  'flower-phenology': buildFlowerPhenologyTable,
  'forest-fires': buildForestFiresTable,
  'grape-harvest-almanac': buildGrapeHarvestAlmanacTable,
  'light-pollution': buildLightPollutionTable,
  'medical-deserts': buildMedicalDesertsTable,
  'monarch-migration': buildMonarchMigrationTable,
  'monument-layers': buildMonumentLayersTable,
  'paris-trees': buildParisTreesTable,
  'satellites-in-orbit': buildSatellitesInOrbitTable,
  'volcanic-eruptions': buildVolcanicEruptionsTable,
};

const LANG = 'en';

export async function getStaticPaths() {
  const [visualizations, frVisualizations] = await Promise.all([
    getCollection('visualizations', (viz) => viz.data.lang === 'en'),
    getCollection('visualizations', (viz) => viz.data.lang === 'fr'),
  ]);
  const frSlugs = new Set(
    frVisualizations.map((viz) => getVisualizationSlug(viz.id, viz.data.lang))
  );
  return visualizations.map((viz) => {
    const slug = getVisualizationSlug(viz.id, viz.data.lang);
    return {
      params: { viz: slug },
      props: { viz, hasTranslation: frSlugs.has(slug) },
    };
  });
}

validateVisualizations(await getCollection('visualizations'), LANG, Object.keys(VIZ_COMPONENTS));

const { viz, hasTranslation } = Astro.props;
const { lang, title, summary, datasets, downloads } = viz.data;
const slug = getVisualizationSlug(viz.id, lang);
const { Content } = await render(viz);

const coverExtension = ['jpg', 'png'].find((ext) =>
  existsSync(join(process.cwd(), 'public', 'covers', `${slug}.${ext}`))
);
const coverPath = coverExtension ? `/covers/${slug}.${coverExtension}` : '/cover-placeholder.svg';
const alternatePath = hasTranslation ? `/fr/${slug}/` : undefined;
const VizComponent = VIZ_COMPONENTS[slug];
const buildTable = VIZ_TABLES[slug];

const retrievedDateFormatter = new Intl.DateTimeFormat(LANG, {
  day: '2-digit',
  month: '2-digit',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<BaseLayout
  title={`${title} · ${en.site.name}`}
  description={summary}
  lang={LANG}
  cover={coverPath}
  alternatePath={alternatePath}
>
  <article class="dv-viz-page">
    <h1>{title}</h1>
    <p class="dv-viz-page__summary">{summary}</p>

    <div class="dv-viz-page__body">
      <Content />
    </div>

    <div class="dv-viz-page__mount">
      {VizComponent && <VizComponent lang={LANG} />}
    </div>

    {buildTable && <DataTable table={buildTable(LANG)} summary={en.viz.tableSummary} />}

    <section class="dv-viz-page__credits">
      <h2>{en.viz.sourcesHeading}</h2>
      <ul class="dv-viz-page__dataset-list">
        {
          datasets.map((dataset) => (
            <li class="dv-viz-page__dataset">
              <a href={dataset.url} target="_blank" rel="noopener" class="dv-viz-page__dataset-name">
                {dataset.name}
              </a>
              <span class="dv-viz-page__dataset-meta">
                {[
                  dataset.publisher,
                  dataset.license,
                  dataset.retrieved &&
                    `${en.viz.retrievedLabel} ${retrievedDateFormatter.format(new Date(dataset.retrieved))}`,
                ]
                  .filter(Boolean)
                  .join(' · ')}
              </span>
            </li>
          ))
        }
      </ul>
      {
        downloads && (
          <DataDownloads
            slug={slug}
            files={downloads}
            lang={LANG}
            label={en.viz.downloadsLabel}
            note={en.viz.downloadsNote}
          />
        )
      }
    </section>

    <RelatedVisualizations viz={viz} heading={en.viz.relatedHeading} />
  </article>
</BaseLayout>

<style>
  .dv-viz-page {
    display: flex;
    flex-direction: column;
    gap: var(--dv-space-4);
  }

  .dv-viz-page__summary {
    margin: 0;
    font-size: 1.125rem;
  }

  /* :global() is required here: <Content /> renders the visualization's
     markdown body without this component's Astro scope attribute, so an
     unscoped .dv-viz-page__body > :first-child rule silently never matches. */
  .dv-viz-page__body > :global(:first-child) {
    margin-top: 0;
  }

  .dv-viz-page__body > :global(:last-child) {
    margin-bottom: 0;
  }

  .dv-viz-page__credits h2 {
    margin-bottom: var(--dv-space-2);
  }

  .dv-viz-page__dataset-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--dv-space-1);
  }

  .dv-viz-page__dataset {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--dv-space-2);
    font-size: 0.875rem;
    font-weight: 300;
    color: var(--dv-ink-secondary);
  }

  .dv-viz-page__dataset-name {
    color: var(--dv-accent);
  }

  .dv-viz-page__mount {
    width: 100%;
    min-height: 480px;
    border: 1px solid var(--dv-gridline);
    border-radius: 4px;
    background-color: var(--dv-surface);
  }
</style>
