---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang?: 'fr' | 'en';
  cover?: string;
  alternatePath?: string;
  structuredData?: object;
}

const {
  title,
  description,
  lang = 'en',
  cover = '/cover-placeholder.svg',
  alternatePath,
  structuredData,
} = Astro.props;

const otherLang = lang === 'fr' ? 'en' : 'fr';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(cover, Astro.site);
const alternateUrl = alternatePath ? new URL(alternatePath, Astro.site) : undefined;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:url" content={canonicalUrl} />

    {
      alternateUrl && (
        <>
          <link rel="alternate" hreflang={lang} href={canonicalUrl} />
          <link rel="alternate" hreflang={otherLang} href={alternateUrl} />
        </>
      )
    }

    <link rel="icon" type="image/png" href="/logo.png" />

    {
      structuredData && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')}
        />
      )
    }
  </head>
  <body>
    <Header />
    <main class="dv-container">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>

<style>
  main {
    padding-block: var(--dv-space-5);
  }
</style>
